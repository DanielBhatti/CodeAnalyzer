<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CodeAnalyzer.UI" xmlns:analysis="using:CodeAnalyzer" x:Class="CodeAnalyzer.UI.MainWindow"
        Title="Code Analyzer" Width="1440" Height="940" MinWidth="1000" MinHeight="700">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
      <StackPanel>
        <TextBlock Text="Code Analyzer" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="Explore structure, coupling, and complexity" Classes="caption" />
      </StackPanel>
      <Button x:Name="OpenButton" Grid.Column="1" Content="Open solution…" VerticalAlignment="Center" />
      <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" IsEnabled="False" VerticalAlignment="Center" />
      <Button x:Name="SettingsButton" Grid.Column="3" Content="Settings" VerticalAlignment="Center" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBox x:Name="PathBox" PlaceholderText="Path to a .slnx, .sln, or project" />
      <Button x:Name="AnalyzeButton" Grid.Column="1" Content="Analyze" />
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="320,12,*" ColumnSpacing="0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <TextBlock Text="SCOPE" Classes="caption" />
        <ComboBox x:Name="ProjectFilter" Grid.Row="1" HorizontalAlignment="Stretch" />
        <CheckBox x:Name="TestsFilter" Grid.Row="2" Content="Include test projects" IsChecked="False" />
        <TextBox x:Name="SearchBox" Grid.Row="3" PlaceholderText="Filter names (RegEx)…" />
        <ComboBox x:Name="TypeSort" Grid.Row="4" SelectedIndex="0" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Sort: Name" />
          <ComboBoxItem Content="Sort: Cyclomatic complexity" />
          <ComboBoxItem Content="Sort: Cognitive complexity" />
          <ComboBoxItem Content="Sort: Class coupling" />
          <ComboBoxItem Content="Sort: Maintainability index" />
          <ComboBoxItem Content="Sort: Dependency cycles" />
          <ComboBoxItem Content="Sort: Lines of code" />
        </ComboBox>
        <Grid Grid.Row="5" RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock x:Name="TypesLabel" Text="Classes / types" Classes="caption" />
          <ListBox x:Name="TypeList" Grid.Row="1">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:TypeRow">
                <StackPanel Margin="0,5">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding FullName}" FontSize="11" Classes="caption" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding MetricsLabel}" FontSize="11" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" />
      <Grid Grid.Column="2" RowDefinitions="*,10,230">
        <TabControl x:Name="Views">
          <TabItem Header="Project dependencies">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <DockPanel>
                <Button x:Name="FitProjects" Content="Reset graph" DockPanel.Dock="Right" ToolTip.Tip="Restore the original layout, selection, and zoom for this graph" />
                <TextBlock x:Name="ProjectGraphLabel" Text="Arrows: project → referenced project · select a node for details" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
              <local:GraphView x:Name="ProjectGraph" Grid.Row="1" />
              <local:GraphLegend x:Name="ProjectLegend" Grid.Row="2" />
            </Grid>
          </TabItem>
          <TabItem Header="Class dependencies">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <DockPanel>
                <Button x:Name="FitTypes" Content="Reset graph" DockPanel.Dock="Right" ToolTip.Tip="Restore the original layout, selection, and zoom for this graph" />
                <TextBlock x:Name="ClassGraphLabel" Text="Select a class to explore its direct dependencies and dependents" Classes="caption" TextWrapping="Wrap" />
              </DockPanel>
              <local:GraphView x:Name="TypeGraph" Grid.Row="1" />
              <local:GraphLegend x:Name="ClassLegend" Grid.Row="2" />
            </Grid>
          </TabItem>
          <TabItem Header="Method complexity">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
              <WrapPanel Orientation="Horizontal">
                <ComboBox x:Name="MethodMetricSelector" SelectedIndex="0" Width="190">
                  <ComboBoxItem Content="Cyclomatic complexity" />
                  <ComboBoxItem Content="Cognitive complexity" />
                  <ComboBoxItem Content="Maintainability index" />
                  <ComboBoxItem Content="Lines of code" />
                </ComboBox>
                <TextBlock Text="Minimum cyclomatic" Classes="caption" VerticalAlignment="Center" Margin="12,0" />
                <NumericUpDown x:Name="MinimumComplexity" Minimum="1" Maximum="10000" Value="1" Width="110" />
                <TextBlock x:Name="MethodCount" Classes="caption" VerticalAlignment="Center" Margin="12,0" />
              </WrapPanel>
              <TextBlock Grid.Row="1" Text="Complexity: lower is simpler. Maintainability: 0–100, higher is better (syntax-based estimate). Select a function for source." Classes="caption" TextWrapping="Wrap" />
              <ListBox x:Name="MethodList" Grid.Row="2">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MethodRow">
                    <Grid ColumnDefinitions="60,*,130" Margin="0,6" ColumnSpacing="12">
                      <TextBlock Text="{Binding ValueLabel}" FontSize="24" FontWeight="SemiBold" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Location}" FontSize="11" Classes="caption" />
                        <TextBlock Text="{Binding MetricsLabel}" FontSize="11" Classes="caption" />
                        <Border Width="{Binding BarWidth}" Background="{Binding BarBrush}" Height="4" HorizontalAlignment="Left" Margin="0,5,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Classes="caption" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <TabItem Header="Definitions">
            <TextBox x:Name="WarningsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     Text="Open a solution to begin. Analysis uses the Debug configuration. Restore the target solution first." />
          </TabItem>
          <TabItem x:Name="SettingsTab" Header="Settings">
            <ScrollViewer>
              <StackPanel Margin="12" Spacing="14" MaxWidth="660" HorizontalAlignment="Left">
                <TextBlock Text="Graph settings" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Changes apply immediately for this session. Your source code is not changed." Classes="caption" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Maximum nodes" FontWeight="SemiBold" />
                    <TextBlock Text="Limit each graph to 1–1,000 nodes. The focused node is always included." Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <NumericUpDown x:Name="MaximumGraphNodes" Grid.Column="1" Minimum="1" Maximum="1000" Value="80" Increment="1" FormatString="0" Width="120" />
                </Grid>
                <StackPanel Spacing="4">
                  <CheckBox x:Name="RecursiveSubgraphs" Content="Expand 2D class subgraphs recursively" IsChecked="False" />
                  <TextBlock Text="Follow dependencies and dependents beyond the focused class's immediate neighbors. Cycles are visited once; the node limit still applies." Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Maximum depth" FontWeight="SemiBold" />
                    <TextBlock Text="Number of connections to follow from the focused class (1–20)." Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <NumericUpDown x:Name="MaximumGraphDepth" Grid.Column="1" Minimum="1" Maximum="20" Value="3" Increment="1" FormatString="0" Width="120" IsEnabled="False" />
                </Grid>
                <CheckBox x:Name="ShowGraphMetrics" Content="Show metrics on graph nodes" IsChecked="True" />
                <CheckBox x:Name="ShowGraphLegend" Content="Show graph legend" IsChecked="True" />
                <Button x:Name="RestoreGraphDefaults" Content="Restore defaults" HorizontalAlignment="Left" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="Class3DTab" Header="Class relationships 3D">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
              <WrapPanel Orientation="Horizontal">
                <CheckBox x:Name="Recursive3D" Content="Recursive relationships" IsChecked="True" VerticalAlignment="Center" />
                <TextBlock Text="Maximum depth" Classes="caption" VerticalAlignment="Center" Margin="12,0" />
                <NumericUpDown x:Name="MaximumDepth3D" Minimum="1" Maximum="20" Value="3" Increment="1" FormatString="0" Width="90" />
                <Button x:Name="FitTypes3D" Content="Reset graph" Margin="12,0" ToolTip.Tip="Restore the original 3D camera and selection" />
              </WrapPanel>
              <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock x:Name="ClassGraph3DLabel" Text="Select a class to explore recursive relationships" Classes="caption" TextWrapping="Wrap" />
                <TextBlock Text="Drag background: rotate · right-drag or Shift-drag: pan · wheel: zoom · click: inspect · double-click: refocus" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <local:Graph3DView x:Name="TypeGraph3D" Grid.Row="2" />
              <Border x:Name="ClassLegend3D" Grid.Row="3" Background="#182232" CornerRadius="6" Padding="10,8">
                <StackPanel Spacing="4">
                  <TextBlock Text="Arrows point to dependencies. Purple: inheritance / interfaces. Gray: usage. Gold outline and lines: selection." FontSize="11" TextWrapping="Wrap" />
                  <TextBlock Text="Node color = highest cyclomatic score: teal ≤ 10, gold 11–20, red &gt; 20. Colors are review cues, not grades." FontSize="11" TextWrapping="Wrap" />
                  <TextBlock Text="Distance from the center shows relationship depth; rotation reveals the third dimension. Hover for metrics." FontSize="11" TextWrapping="Wrap" Classes="caption" />
                </StackPanel>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" HorizontalAlignment="Stretch" />
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock x:Name="DetailTitle" Text="Selection details and source preview" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <ScrollViewer x:Name="SourceScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Top">
              <TextBox x:Name="LineNumbersBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                       FontSize="12" LineHeight="18" TextWrapping="NoWrap" TextAlignment="Right" Foreground="SlateGray"
                       IsHitTestVisible="False" Focusable="False" IsVisible="False" MinWidth="48" Padding="8,4" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
              <TextBox x:Name="SourceBox" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                       FontSize="12" LineHeight="18" TextWrapping="NoWrap" Padding="8,4" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       Text="Mouse wheel: zoom · drag background: pan · drag nodes: rearrange · double-click a class node: explore its neighborhood" />
            </Grid>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="3" Text="Ready" Classes="caption" TextWrapping="Wrap" />
  </Grid>
</Window>
