<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeAnalyzer.UI.GraphLegend">
  <Border Background="#182232" CornerRadius="6" Padding="10,8">
    <StackPanel Spacing="4">
      <TextBlock TextWrapping="Wrap" FontSize="11">
        <Run FontWeight="SemiBold">Graph legend · </Run>
        <Run>Arrows point from a type or project to a dependency. </Run>
        <Run Foreground="MediumPurple">Purple</Run><Run>: inheritance / interfaces. </Run>
        <Run Foreground="SlateGray">Gray</Run><Run>: usage / project references.</Run>
      </TextBlock>
      <TextBlock TextWrapping="Wrap" FontSize="11">
        <Run Foreground="Gold">Gold outline and lines</Run><Run>: selected card and its connections. </Run>
        <Run>Class card strip = highest cyclomatic score: </Run>
        <Run Foreground="MediumTurquoise">teal ≤ 10</Run><Run>, </Run>
        <Run Foreground="Gold">gold 11–20</Run><Run>, </Run>
        <Run Foreground="Salmon">red &gt; 20</Run><Run>. Colors are review cues, not grades.</Run>
      </TextBlock>
      <TextBlock Text="Wheel to zoom · drag background to pan · drag cards to move · double-click a class to explore · Reset graph restores the layout and view"
                 TextWrapping="Wrap" FontSize="11" Classes="caption" />
    </StackPanel>
  </Border>
</UserControl>
